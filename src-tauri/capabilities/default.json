{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Start-up page bundled with the app (shown only when the local server could not start).",
  "windows": ["main"],
  "permissions": [
    "core:app:allow-version",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "allow-startup-status",
    "allow-retry-server",
    "allow-restart-server",
    "allow-open-external"
  ]
}
