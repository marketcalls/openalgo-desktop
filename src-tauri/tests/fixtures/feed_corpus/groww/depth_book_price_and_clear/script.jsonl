{"step": "push", "frame": {"text": "INFO {\"server_id\":\"corpus\",\"version\":\"2.10.18\",\"headers\":true,\"max_payload\":1048576}\r\n"}, "connection": 2, "note": "The NATS server's INFO opens the session."}
{"step": "upstream_receives", "frames": [{"text": "CONNECT {\"verbose\": false, \"pedantic\": false, \"tls_required\": true, \"jwt\": \"socket-jwt\", \"protocol\": 1, \"version\": \"2.10.18\", \"lang\": \"python3\", \"name\": \"nats.py\", \"headers\": true, \"no_responders\": true}\r\n"}], "connection": 2, "note": "CONNECT once per connection, with the socket token (its PING is a heartbeat, ignored)."}
{"step": "push", "frame": {"text": "+OK\r\n"}, "connection": 2, "note": "+OK accepts the session; subscriptions follow."}
