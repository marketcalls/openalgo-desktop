{"step": "upstream_connected", "socket": "orders", "connection": 1, "path": "/ws/v1/feeds?login_id=c&access_token=t", "note": "The order socket: the market feed's address, the session's client id and access token in the query (pocketful_order_adapter.py get_ws_url)."}
{"step": "upstream_receives", "socket": "orders", "frames": [{"json": {"a": "subscribe", "v": ["c", "web"], "m": "updates"}}], "note": "The SDKs' subscribe_order_update, sent once the socket is open (on_open_extra)."}
{"step": "send", "client": "a", "message": {"action": "subscribe_orders"}, "reply": {"type": "subscribe_orders", "status": "success", "message": "Subscribed to order updates"}}
{"step": "push", "socket": "orders", "frame": "frames/order_open.hex"}
{"step": "receive", "client": "a", "frame": "expected/order_open.json"}
{"step": "push", "socket": "orders", "frame": "frames/order_partial.hex"}
{"step": "receive", "client": "a", "frame": "expected/order_partial.json"}
{"step": "push", "socket": "orders", "frame": "frames/trade.hex"}
{"step": "silence", "client": "a", "note": "A trade update is not published: its order update carries the fill and the order's totals."}
{"step": "push", "socket": "orders", "frame": "frames/two_orders.hex", "note": "A header byte that is not UTF-8 (0xE8): the JSON is cut from the bytes, so the update is read anyway."}
{"step": "receive", "client": "a", "frame": "expected/order_complete.json"}
{"step": "receive", "client": "a", "frame": "expected/order_rejected.json"}
{"step": "push", "socket": "orders", "frame": "frames/order_cancelled.hex"}
{"step": "receive", "client": "a", "frame": "expected/order_cancelled.json"}
{"step": "push", "socket": "orders", "frame": "frames/market_packet.hex"}
{"step": "silence", "client": "a"}
{"step": "drop_upstream", "socket": "orders", "note": "Pocketful closes the order socket; the manager reconnects."}
{"step": "upstream_connected", "socket": "orders", "connection": 2, "path": "/ws/v1/feeds?login_id=c&access_token=t"}
{"step": "upstream_receives", "socket": "orders", "frames": [{"json": {"a": "subscribe", "v": ["c", "web"], "m": "updates"}}], "note": "The new socket subscribes again."}
{"step": "push", "socket": "orders", "frame": "frames/after_reconnect.hex"}
{"step": "receive", "client": "a", "frame": "expected/after_reconnect.json"}
