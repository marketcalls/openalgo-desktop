# Dhan binary frame: one quote packet (code 4).
04                      # response code 4 (quote)
3200                    # message length 50, header included
01                      # exchange segment 1 (NSE_EQ)
450b0000                # security id 2885
0090a244                # ltp
1900                    # last traded quantity
a0680169                # last trade time, epoch s
0048a244                # average traded price
409c0000                # volume
581b0000                # total sell quantity
28230000                # total buy quantity
0040a144                # open
00000000                # day close (0 until the market closes)
00c0a344                # high
00a0a044                # low
