# A quote packet whose prices are not exact in an f32 (the review's LTP 954.1: bytes 66 86 6e 44).
04                      # response code 4 (quote)
3200                    # message length 50, header included
01                      # exchange segment 1 (NSE_EQ)
450b0000                # security id 2885
66866e44                # ltp 954.1
0700                    # last traded quantity 7
a0680169                # last trade time, epoch s
66766e44                # average traded price 953.85
c0d40100                # volume 120000
04100000                # total sell quantity 4100
3c0f0000                # total buy quantity 3900
33d36d44                # open 951.3
00000000                # day close (0 until the market closes)
cd5c6f44                # high 957.45
9a096d44                # low 948.15
