# Dhan binary frame: a quote packet (code 4) for the NIFTY index; Dhan sends no quantities for an index.
04                      # response code 4 (quote)
3200                    # message length 50, header included
00                      # exchange segment 0 (IDX_I)
0d000000                # security id 13
003dbe46                # ltp 24350.5
0000                    # last traded quantity 0
ede2f26a                # last trade time, epoch s
00000000                # average traded price 0.0
00000000                # volume 0
00000000                # total sell quantity 0
00000000                # total buy quantity 0
00ecbd46                # open 24310.0
00000000                # day close (0 until the market closes)
80a0be46                # high 24400.25
80c5bd46                # low 24290.75
