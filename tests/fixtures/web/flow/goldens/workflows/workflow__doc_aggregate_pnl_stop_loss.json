    "position": {
     "x": 240,
     "y": 540
    },
    "data": {
     "message": "PnL stop-loss tripped at {{totalPnL}}, all positions squared off"
    }
   }
  ],
  "edges": [
   {
    "id": "e1",
    "source": "node_1",
    "target": "node_2"
   },
   {
    "id": "e2",
    "source": "node_2",
