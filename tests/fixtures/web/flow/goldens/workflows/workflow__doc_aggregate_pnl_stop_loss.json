 "workflow": {
  "name": "Aggregate PnL Stop-Loss",
  "description": "Square off when total open-position pnl falls below -2000",
  "nodes": [
   {
    "id": "node_1",
    "type": "start",
    "position": {
     "x": 100,
     "y": 60
    },
    "data": {
