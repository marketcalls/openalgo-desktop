# OpenAlgo Desktop - Tauri + React + Rust

# ============================================================================
# Node.js / npm
# ============================================================================
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.yarn/
.pnpm-store/

# ============================================================================
# Build Output
# ============================================================================
dist/
dist-ssr/
build/
.next/
out/

# Tauri / Cargo build output (any target dir, incl. CARGO_TARGET_DIR overrides)
target/
src-tauri/target/
src-tauri/gen/
src-tauri/WixTools/
src-tauri/*.nsis.log

# ============================================================================
# Rust / Cargo
# ============================================================================
**/*.rs.bk
# Cargo.lock IS committed: this is an application, and CI builds with --locked.
# Coverage / profiling output from cargo-llvm-cov and friends
*.profraw
*.profdata
lcov.info

# ============================================================================
# Environment & Config
# ============================================================================
.env
.env.*
*.env
!.env.example
*.local
# The desktop app has no .env; these patterns are defensive only.

# ============================================================================
# Database Files
# ============================================================================
*.db
*.db-shm
*.db-wal
*.db-journal
*.duckdb
*.duckdb.wal
*.sqlite
*.sqlite3

# ============================================================================
# Logs & Temporary Files
# ============================================================================
*.log
*.tmp
logs/
tmp/
.temp/
checkpoint.txt
checkpoints.json

# ============================================================================
# IDE & Editor
# ============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.code-workspace

# Claude Code local worktrees and settings
.claude/worktrees/
.claude/settings.local.json

# ============================================================================
# OS Generated Files
# ============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ============================================================================
# Testing & Coverage
# ============================================================================
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
playwright-report-flow/
blob-report/
playwright/.cache/
junit*.xml
vitest-junit.xml

# Raw captures that may still carry real credentials, account ids or emails.
# Only scrubbed fixtures (with <APIKEY>, <USER_ID>, <EMAIL> placeholders) are
# committed under tests/fixtures/; raw recordings stay local.
*.har
captures/
capture-raw/
scratch/
scratchpad/
tests/fixtures/**/raw/
tests/fixtures/**/*.raw.json
tests/fixtures/**/*.raw.txt

# ============================================================================
# TypeScript
# ============================================================================
*.tsbuildinfo

# ============================================================================
# Code Signing & Security (NEVER commit these)
# ============================================================================
*.pem
*.p12
*.key
*.crt
*.provisionprofile
*.mobileprovision

# ============================================================================
# Release Artifacts (large binary files)
# ============================================================================
*.dmg
*.msi
*.exe
*.deb
*.AppImage
*.rpm
*.snap

# QA audit reports and exports (account data: order ids, positions, funds)
*.xlsx
*.csv
# Broker fixtures and the bundled freeze-quantity list are tracked CSVs
!src-tauri/**/*.csv
.qa-venv/
docs/audit/qa_audit/**/qa_shapes.json
__pycache__/
~$*
